#include <stdio.h>
struct Process {
    int pid, at, bt, wt, tat, type;
};
void sortByAT(struct Process p[], int n) {
    int i, j;
    struct Process temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].at > p[j + 1].at) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }
}

void fcfs(struct Process p[], int n) {
    int i;

    p[0].wt = 0;

    for (i = 1; i < n; i++) {
        int prev_finish = p[i - 1].at + p[i - 1].wt + p[i - 1].bt;

        if (prev_finish > p[i].at)
            p[i].wt = prev_finish - p[i].at;
        else
            p[i].wt = 0;
    }

    for (i = 0; i < n; i++) {
        p[i].tat = p[i].wt + p[i].bt;
    }
}


void display(struct Process p[], int n) {
    int i;
    float avg_wt = 0, avg_tat = 0;

    printf("\nPID\tAT\tBT\tWT\tTAT\n");

    for (i = 0; i < n; i++) {
        printf("%d\t%d\t%d\t%d\t%d\n",
               p[i].pid, p[i].at, p[i].bt, p[i].wt, p[i].tat);

        avg_wt += p[i].wt;
        avg_tat += p[i].tat;
    }

    printf("\nAverage WT = %.2f", avg_wt / n);
    printf("\nAverage TAT = %.2f\n", avg_tat / n);
}

int main() {
    int n, i;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n], sys[n], user[n];
    int sys_n = 0, user_n = 0;

    printf("Enter AT, BT and Type (1-System, 2-User):\n");

    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("P%d: ", p[i].pid);
        scanf("%d %d %d", &p[i].at, &p[i].bt, &p[i].type);

        if (p[i].type == 1)
            sys[sys_n++] = p[i];
        else
            user[user_n++] = p[i];
    }

   
    sortByAT(sys, sys_n);
    sortByAT(user, user_n);

    printf("\n--- System Processes (Higher Priority) ---\n");
    if (sys_n > 0) {
        fcfs(sys, sys_n);
        display(sys, sys_n);
    }

    printf("\n--- User Processes (Lower Priority) ---\n");
    if (user_n > 0) {
        fcfs(user, user_n);
        display(user, user_n);
    }

    return 0;
}
